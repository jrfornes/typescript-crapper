{
  "name": "typescript-crapper",
  "version": "0.1.0",
  "description": "TypeScript CRAP metrics from cyclomatic complexity and LCOV coverage",
  "type": "module",
  "bin": {
    "typescript-crapper": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "edn-data": "^1.1.2",
    "vitest": "^3.1.2"
  }
}
